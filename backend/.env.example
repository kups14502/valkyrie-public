# Server bind (use 127.0.0.1 - traffic comes through Cloudflare Tunnel)
BIND=127.0.0.1
PORT=3001

# Cloudflare Access Zero Trust (set in production)
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=your-audience-tag-from-cloudflare-zero-trust

# CORS - comma-separated allowed origins (Cloudflare Pages domain)
ALLOWED_ORIGINS=https://valkyrie.brendonkupsch.com

# Local services
HA_URL=http://localhost:8123
HA_TOKEN=your-home-assistant-long-lived-token
OPENCLAW_URL=http://localhost:8080
VAULTWARDEN_URL=http://localhost:8000
TRADING_URL=http://localhost:5000

# Assistant (Jarvis kiosk) — see docs/assistant.md
# Media library control: keys from each app's config.xml (<ApiKey>) in
# /home/brendon/docker/media-stack/<app>/config.xml
RADARR_URL=http://127.0.0.1:7878
RADARR_API_KEY=from-radarr-config-xml
SONARR_URL=http://127.0.0.1:8989
SONARR_API_KEY=from-sonarr-config-xml
# Optional overrides; defaults are the first root folder / quality profile
#RADARR_ROOT_FOLDER=/path/to/movies
#RADARR_QUALITY_PROFILE_ID=1
#SONARR_ROOT_FOLDER=/path/to/tv
#SONARR_QUALITY_PROFILE_ID=1
# Voice services (systemd user units whisper-stt.service / valkyrie-tts.service)
WHISPER_URL=http://127.0.0.1:8378
KOKORO_URL=http://127.0.0.1:8379
KOKORO_VOICE=bm_george
#KOKORO_SPEED=1.0
# Agent identity/model
#VALKYRIE_ASSISTANT_NAME=Jarvis
#VALKYRIE_ASSISTANT_MODEL=claude-sonnet-5
#VALKYRIE_ROOT=/home/brendon/valkyrie
# Kiosk static dir override (default: ../frontend/dist-kiosk relative to backend/dist)
#KIOSK_DIR=

NODE_ENV=production
