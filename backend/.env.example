# Server bind (use 127.0.0.1 - traffic comes through Cloudflare Tunnel)
BIND=127.0.0.1
PORT=3001

# Cloudflare Access Zero Trust (set in production)
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=your-audience-tag-from-cloudflare-zero-trust

# CORS - comma-separated allowed origins (Cloudflare Pages domain)
ALLOWED_ORIGINS=https://valkyrie.brendonkupsch.com

# Local services
HA_URL=http://localhost:8123
HA_TOKEN=your-home-assistant-long-lived-token
OPENCLAW_URL=http://localhost:8080
VAULTWARDEN_URL=http://localhost:8000
TRADING_URL=http://localhost:5000

# Tailnet listener: also serve the API (and frontend/dist, if built) on the
# tailscale interface. Requests from 100.64.0.0/10 peers are trusted without a
# token (WireGuard already authenticated the device).
TAILNET_BIND=100.96.237.89
TAILNET_PORT=8420
# Exact origins of the app as the tailnet serves it (comma-separated), for
# example the `tailscale serve` https name. CORS and the Host check accept
# these and nothing else from *.ts.net. Unset, the app opened through
# `tailscale serve` gets 403 unknown host.
TAILNET_ORIGINS=https://yourhost.your-tailnet.ts.net
# Further Host names a tailnet or loopback request may carry. Loopback,
# TAILNET_BIND, 'odin' and the TAILNET_ORIGINS hosts are always accepted.
# ALLOWED_HOSTS=
# Override where the built web frontend lives (default: ../frontend/dist)
# FRONTEND_DIST=/home/brendon/valkyrie/frontend/dist

# Media stack (Plex view + requests)
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=your-plex-token-from-preferences-xml
# The music library lives on a second Plex server (LogicServer over the
# tailnet). Same account, so the token defaults to PLEX_TOKEN. Leave the URL
# unset and there is no music tab.
PLEX_MUSIC_URL=http://100.74.186.84:32400
# PLEX_MUSIC_TOKEN=
RADARR_URL=http://127.0.0.1:7878
RADARR_API_KEY=your-radarr-api-key
SONARR_URL=http://127.0.0.1:8989
SONARR_API_KEY=your-sonarr-api-key
# Lidarr runs on LogicServer beside the music library (album requests).
# Reached over the tailnet; unset and album requests are absent from search.
LIDARR_URL=http://100.74.186.84:8686
LIDARR_API_KEY=your-lidarr-api-key

NODE_ENV=production

# thor's session launcher agent (Sessions page: Launch / Restore my desk).
# The token is shared with C:\Thor\secrets\session-launcher-token.txt on thor.
# Leave THOR_LAUNCHER_TOKEN unset and the launch routes answer 501, which the
# frontend renders as a calm "launcher unavailable" banner.
THOR_LAUNCHER_HOST=100.118.7.57
THOR_LAUNCHER_PORT=8766
THOR_LAUNCHER_TOKEN=

# Calendar tab. Feeds are managed in the UI (Calendar → sources); CALENDAR_SEED_ICS_URL
# only seeds the first one on a fresh install. Publish it from Outlook Web:
# Calendar → Share → Publish a calendar → ICS link.
CALENDAR_SEED_ICS_URL=
CALENDAR_SEED_LABEL=Work
# Zone used for all-day events and for feeds that omit TZID.
CALENDAR_TZ=America/New_York
# CALENDAR_REFRESH_MS=600000

# Meals tab: photo → macro estimation. With ANTHROPIC_API_KEY set it calls the
# Messages API directly (a couple of seconds). Without one it shells out to the
# claude CLI under a signed-in profile, which spends the subscription instead
# (30 to 60 seconds). MEALS_CLAUDE_ACCOUNT is an id from the accounts file
# below (default: its first entry); CLAUDE_CLI_PATH overrides where the CLI is found.
ANTHROPIC_API_KEY=
MEALS_CLAUDE_ACCOUNT=
MEALS_MODEL=claude-sonnet-5

# Claude subscriptions the AI usage tab reads (lib/claudeAccounts.ts): a JSON
# array of { id, label, email, subscription, configDir }, kept out of the repo
# because it is account data. The first entry is the primary card and the one
# the session-reset alerts watch. Unset or missing: one card for ~/.claude.
# CLAUDE_ACCOUNTS_FILE=~/.config/valkyrie/claude-accounts.json

# Extra cwd patterns the session board redacts before publishing (routes/
# workspaces.ts), one case-insensitive regex per line in this file. The
# SharePoint and business-OneDrive sync roots are always redacted; name the
# organization folders here so a copy reached any other way is caught too.
# REDACT_PATHS_FILE=~/.config/valkyrie/redact-paths.txt

# How odin's own sessions are routed to areas (routes/workspaces.ts): a JSON
# array of { area, pattern, flags? }, first match wins, kept out of the repo
# because it names project folders. Missing: every odin session is 'server'.
# ODIN_AREAS_FILE=~/.config/valkyrie/odin-areas.json
