# Server bind (use 127.0.0.1 - traffic comes through Cloudflare Tunnel)
BIND=127.0.0.1
PORT=3001

# Cloudflare Access Zero Trust (set in production)
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=your-audience-tag-from-cloudflare-zero-trust

# CORS - comma-separated allowed origins (Cloudflare Pages domain)
ALLOWED_ORIGINS=https://valkyrie.brendonkupsch.com

# Local services
HA_URL=http://localhost:8123
HA_TOKEN=your-home-assistant-long-lived-token
OPENCLAW_URL=http://localhost:8080
VAULTWARDEN_URL=http://localhost:8000
TRADING_URL=http://localhost:5000

# Tailnet listener: also serve the API (and frontend/dist, if built) on the
# tailscale interface. Requests from 100.64.0.0/10 peers are trusted without a
# token (WireGuard already authenticated the device).
TAILNET_BIND=100.96.237.89
TAILNET_PORT=8420
# Override where the built web frontend lives (default: ../frontend/dist)
# FRONTEND_DIST=/home/brendon/valkyrie/frontend/dist

# Media stack (Plex view + requests)
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=your-plex-token-from-preferences-xml
RADARR_URL=http://127.0.0.1:7878
RADARR_API_KEY=your-radarr-api-key
SONARR_URL=http://127.0.0.1:8989
SONARR_API_KEY=your-sonarr-api-key

NODE_ENV=production

# thor's session launcher agent (Sessions page: Launch / Restore my desk).
# The token is shared with C:\Thor\secrets\session-launcher-token.txt on thor.
# Leave THOR_LAUNCHER_TOKEN unset and the launch routes answer 501, which the
# frontend renders as a calm "launcher unavailable" banner.
THOR_LAUNCHER_HOST=100.118.7.57
THOR_LAUNCHER_PORT=8766
THOR_LAUNCHER_TOKEN=

# Calendar tab. Feeds are managed in the UI (Calendar → sources); WORK_ICS_URL
# only seeds the first one on a fresh install. Publish it from Outlook Web:
# Calendar → Share → Publish a calendar → ICS link.
WORK_ICS_URL=
WORK_ICS_LABEL=Work
# Zone used for all-day events and for feeds that omit TZID.
CALENDAR_TZ=America/New_York
# CALENDAR_REFRESH_MS=600000

# Meals tab: photo → macro estimation. With ANTHROPIC_API_KEY set it calls the
# Messages API directly (a couple of seconds). Without one it shells out to the
# claude CLI under a signed-in profile, which spends the subscription instead
# (30 to 60 seconds). MEALS_CLAUDE_ACCOUNT is an id from CLAUDE_ACCOUNTS in
# routes/aiUsage.ts; CLAUDE_CLI_PATH overrides where the CLI is found.
ANTHROPIC_API_KEY=
MEALS_CLAUDE_ACCOUNT=claude-acct-a
MEALS_MODEL=claude-sonnet-5
