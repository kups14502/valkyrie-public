# Kiosk build (npm run build:kiosk → vite --mode kiosk): served by the backend
# itself at http://127.0.0.1:3001/kiosk/, so the API must stay same-origin
# ('/api', loopback auth bypass). This mode file exists so .env.production's
# VITE_API_URL (the Cloudflare hostname) is NOT loaded for kiosk builds.
VITE_API_URL=
