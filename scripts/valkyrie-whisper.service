[Unit]
Description=Valkyrie voice input (whisper.cpp server on loopback, for the Raven composer's mic)
Documentation=https://github.com/kups14502/valkyrie
After=default.target

[Service]
# The API (POST /api/raven/transcribe) hands it the recorded clip as it came from the
# browser (webm/opus, or mp4/aac from iOS); --convert has ffmpeg turn it into 16 kHz WAV.
# Loopback only: nothing off this host reaches it.
# base.en q5_1 (60 MB): about 3x faster than small.en (ggml-small.en-q5_1.bin, also in models/)
# with a little less accuracy. Normal priority: he waits on the words.
WorkingDirectory=%h/.cache/valkyrie-whisper
ExecStartPre=/usr/bin/mkdir -p %h/.cache/valkyrie-whisper
ExecStart=%h/whisper.cpp/build/bin/whisper-server -m %h/whisper.cpp/models/ggml-base.en-q5_1.bin --host 127.0.0.1 --port 8771 -t 4 -bo 1 -nt --convert
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
